# Database Connection String (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_bridge

# Server Port (default is 3000)
PORT=3000

# Supabase (optional, if using Supabase features in secure.js or email.js)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret for signing tokens
JWT_SECRET=vb-development-secret-key-change-in-production-environments
