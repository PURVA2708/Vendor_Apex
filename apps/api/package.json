{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const {execSync}=require('child_process');try{const r=execSync('netstat -ano | findstr :3000 | findstr LISTEN',{shell:'cmd.exe',encoding:'utf8'});r.trim().split('\\n').forEach(l=>{const p=l.trim().split(/\\s+/).pop();if(/^\\d+$/.test(p))try{execSync('taskkill /PID '+p+' /F',{stdio:'ignore'})}catch(e){}});}catch(e){}\"",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "verify": "node verify.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.12.0"
  }
}
